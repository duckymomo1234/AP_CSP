# AP, numbers guessing game

import random

print("Hello! Welcome to Alice's guessing game! You have six tries to guess a number 1-100. READY? SET? GO!")

number = random.randint(1,100) 
tries = 0

while tries < 6:
  guess = int(input("What is your next guess?:"))

  if guess < number:
    print("Too low")
  elif guess > number:
    print("Too high")
  else:
    print("Correct!")
    break

  tries = tries + 1
